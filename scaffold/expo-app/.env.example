# Copy to `.env` and fill in from the Firebase console (Project settings → Your apps → Web app),
# or let Radiance write these for you after connecting Google.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Native Firebase app ids for App Distribution (`radiance deploy --app-distribution`).
# Written by `radiance setup firebase` — not used by the Expo JS SDK.
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=

# Point the app at the local Firebase Emulator Suite instead of the live project.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
# Use your machine's LAN IP when testing on a physical device.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost
# Per-product toggles (default on when master switch is true; set to false to skip).
EXPO_PUBLIC_EMULATOR_AUTH=true
EXPO_PUBLIC_EMULATOR_FIRESTORE=true
EXPO_PUBLIC_EMULATOR_FUNCTIONS=true
EXPO_PUBLIC_EMULATOR_STORAGE=true

# Side-by-side installs: development | preview | production (see eas.json / app.config.ts).
# APP_VARIANT=development
