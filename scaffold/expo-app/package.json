{
  "name": "{{radiance.slug}}",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node ./scripts/dev-start.mjs",
    "android": "node ./scripts/dev-start.mjs --android",
    "ios": "node ./scripts/dev-start.mjs --ios",
    "web": "node ./scripts/dev-start.mjs --web",
    "start:app": "expo start --dev-client",
    "export:web": "expo export --platform web",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "emulators": "firebase emulators:start"
  },
  "dependencies": {
    "expo": "~57.0.11",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.12",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.17.1",
    "mitt": "^3.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
