{
  "id": "expo-app",
  "version": "0.2.5",
  "title": "Expo app scaffold",
  "description": "Generic Expo Router + Firebase application shell. Runs on its own and is the base every Radiance module and starter builds on.",
  "expoSdk": 57,
  "requiredModules": ["i18n", "theme", "navigation", "settings"],
  "markers": {
    "providers": "lib/registry/providers.tsx",
    "firestoreRules": "firestore.rules",
    "storageRules": "storage.rules"
  },
  "capabilities": [
    "expo-router",
    "expo-dev-client",
    "hermes",
    "typescript",
    "firebase-config",
    "eslint-prettier",
    "eas-variants",
    "platform-helpers",
    "logger",
    "app-events",
    "jest"
  ]
}
