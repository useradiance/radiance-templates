{
  "id": "events",
  "version": "0.2.0",
  "extends": "expo-app",
  "title": "Events",
  "description": "Event listings with organizer UI, RSVP, QR door tickets, scheduled reminders, and optional Stripe tickets.",
  "modules": [
    "i18n",
    "theme",
    "navigation",
    "firestore",
    "forms",
    "auth",
    "calendar",
    "stripe",
    "push-notifications",
    "deep-linking",
    "share",
    "barcode",
    "hosting",
    "analytics",
    "callable-client",
    "functions",
    "demo-data"
  ],
  "overlay": "overlay",
  "capabilities": ["events", "rsvp", "tickets", "event-list"],
  "firebase": {
    "rules": {
      "firestore": "firebase/firestore.rules.fragment"
    },
    "indexes": "firebase/firestore.indexes.json"
  },
  "defaults": {
    "themePack": "flare"
  }
}
