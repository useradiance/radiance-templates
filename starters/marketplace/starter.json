{
  "id": "marketplace",
  "version": "0.1.1",
  "extends": "expo-app",
  "title": "Marketplace",
  "description": "Two-sided listings with search, maps, Stripe checkout, and seller roles.",
  "modules": [
    "i18n",
    "theme",
    "navigation",
    "firestore",
    "forms",
    "auth",
    "storage",
    "stripe",
    "search",
    "roles",
    "maps",
    "analytics",
    "hosting",
    "callable-client",
    "functions",
    "demo-data"
  ],
  "overlay": "overlay",
  "capabilities": ["marketplace", "listings", "buy-sell", "classifieds", "two-sided"],
  "firebase": {
    "rules": {
      "firestore": "firebase/firestore.rules.fragment"
    },
    "indexes": "firebase/firestore.indexes.json"
  },
  "defaults": {
    "themePack": "hearth"
  }
}
