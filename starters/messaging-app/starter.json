{
  "id": "messaging-app",
  "version": "0.2.0",
  "extends": "expo-app",
  "title": "Messaging app",
  "description": "Direct messages with threads, push notifications to other members, and deep links.",
  "modules": [
    "i18n",
    "theme",
    "navigation",
    "firestore",
    "forms",
    "auth",
    "storage",
    "callable-client",
    "functions",
    "chat",
    "push-notifications",
    "deep-linking",
    "analytics",
    "hosting",
    "demo-data"
  ],
  "overlay": "overlay",
  "capabilities": ["messaging", "chat", "dm", "inbox", "conversations"],
  "firebase": {
    "rules": {
      "firestore": "firebase/firestore.rules.fragment"
    },
    "indexes": "firebase/firestore.indexes.json"
  },
  "defaults": {
    "themePack": "ocean"
  }
}
